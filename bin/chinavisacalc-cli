const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('chinavisacalc-cli v1.0.0 (https://chinavisacalc.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'chinavisacalc.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'chinavisacalc.com', benchmark: "Foreigner Work Permit Classification & SAFEA Points Matrix", rows: SPECS }, null, 2));
  process.exit(0);
}

